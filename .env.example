# Supabase: Project Settings → API (o "Connect" en el panel del proyecto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para aplicar migraciones desde aquí: Project Settings → Database → Connection string (URI, modo "Session")
# Reemplaza [YOUR-PASSWORD] por la contraseña de la base de datos.
SUPABASE_DB_URL=

# Opcional: dirección pública del sitio para los enlaces de correo y el retorno de Google (en producción, tu dominio).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
