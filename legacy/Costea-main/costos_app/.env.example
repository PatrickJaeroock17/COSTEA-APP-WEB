# Generate a different random secret for each installation (at least 32 characters).
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
APP_ENV=development
# Single SQL Server database for application data, catalog, dishes and recipes.
# Adjust localhost/credentials for the target instance.
DATABASE_URL=mssql+pyodbc://@localhost/Costea_Cevicheria?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&Encrypt=yes&TrustServerCertificate=yes
# For a future HTTPS deployment use APP_ENV=production and shared Redis storage.
RATELIMIT_STORAGE_URI=memory://
# Optional comma-separated host names, without scheme or port.
# TRUSTED_HOSTS=localhost,127.0.0.1

# SQL authentication alternative: URL-encode username/password; keep the real value in .env only.
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@SERVER/Costea_Cevicheria?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes
# Stable installation identifier, generated once by scripts/prepare_local.py.
# Preserve the generated value across updates and backups.
# APP_INSTANCE_ID=<UUID-generated-by-prepare_local>
